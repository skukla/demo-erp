{
  "name": "demo-erp",
  "contractVersion": 2,
  "description": "What the ERP promises its subscribers: the routes it serves, the shapes it accepts, and the events it publishes. The Commerce integration vendors this file and its tests fail when the two disagree.",
  "routes": {
    "health": ["GET"],
    "settings": ["GET", "PATCH"],
    "admin": ["POST /wipe", "POST /import", "POST /sync"],
    "products": ["GET", "GET /:sku", "PATCH /:sku", "DELETE /:sku"],
    "partners": ["GET", "GET /:id", "PATCH /:id"],
    "pricing": ["GET", "POST", "DELETE /:id", "POST /quote"],
    "orders": ["GET", "GET /:number", "POST", "POST /:number/confirm", "POST /:number/cancel", "POST /:number/shipments", "POST /:number/shipments/:shipment/post", "POST /:number/lines/:item/close", "POST /:number/invoice", "POST /:number/credit/release", "POST /:number/credit/reject", "POST /:number/credit/hold", "POST /:number/commerce-shipment", "POST /:number/commerce-invoice", "POST /:number/status"],
    "shipments": ["GET", "GET /:number"],
    "invoices": ["GET", "GET /:number"],
    "events": ["GET", "POST /retry", "POST /requeue"],
    "search": ["GET"]
  },
  "import": {
    "products": ["sku", "name", "listPrice", "warehouses", "type", "parentSku", "variantAttributes"],
    "productTypes": ["simple", "configurable"],
    "variantAttribute": ["label", "value"],
    "warehouse": ["code", "name", "quantity"],
    "partners": ["id", "name", "commerceCompanyId", "customerGroupId", "emailDomain", "creditLimit", "blocked", "salesOrgs", "legalName", "vatTaxId", "resellerId", "legalAddress", "website"],
    "partnersNote": "salesOrgs, legalName, vatTaxId, resellerId, legalAddress and website arrive with contract version 2 (business structure); an ERP at version 1 ignores them, an integration at version 1 does not send them",
    "legalAddress": ["street", "city", "region", "postcode", "countryId", "telephone"],
    "website": ["id", "code"],
    "structure": ["websites"],
    "structureWebsite": ["code", "name", "salesOrg", "salesOrgName", "storeInfo"],
    "storeInfo": ["currency", "countryId", "vatNumber", "address"],
    "stock": ["sku", "warehouses"],
    "stockNote": "quantities per warehouse for products the ERP already has (the integration's minute refresh of Commerce's source items); a SKU the ERP does not have is reported under stock.unknown and not created; a stock-only import does not move lastImportAt",
    "projectName": "optional"
  },
  "quote": {
    "request": ["partnerId", "commerceCompanyId", "email", "customerGroupId", "lines", "date"],
    "requestLine": ["sku", "qty"],
    "responseLine": ["sku", "qty", "listPrice", "contractPrice", "discountPercent", "maxDiscountPercent", "source", "lineTotal", "notApplied"],
    "unknownLine": ["sku", "qty", "unknown"]
  },
  "order": {
    "request": ["commerceOrderId", "commerceIncrementId", "partnerId", "commerceCompanyId", "email", "customerGroupId", "lines", "currency", "total", "salesOrg", "salesOrgName"],
    "requestLine": ["sku", "qty", "price", "commerceItemId"],
    "response": ["number", "commerceOrderId", "commerceIncrementId", "partnerId", "lines", "currency", "total", "status", "header", "shipments", "invoice", "creditStatus", "creditReason", "creditDecidedAt", "history", "createdAt", "salesOrg", "salesOrgName"],
    "fromCommerce": {
      "note": "A move made IN Commerce carries origin: { event, eventId? }. The ERP records it, journals it as received, and raises no outbound event for it, so Commerce is not asked to do it twice.",
      "commerceShipment": ["commerceShipmentId", "items", "sourceCode", "origin"],
      "commerceShipmentItem": ["orderItemId", "qty"],
      "commerceInvoice": ["commerceInvoiceId", "origin"],
      "cancel": ["reason", "origin"],
      "cancelReasonFromCommerce": "Cancelled in Commerce",
      "hold": ["reason", "origin"],
      "release": ["origin"]
    }
  },
  "events": {
    "be-observer.catalog_product_update": { "raisedBy": "product.price", "value": ["sku", "name", "price"] },
    "be-observer.catalog_stock_update": { "raisedBy": "product.stock", "valueIsArray": true, "value": ["sku", "source", "quantity", "outOfStock"] },
    "be-observer.sales_order_status_update": { "raisedBy": "order.confirmed", "value": ["id", "orderId", "incrementId", "erpNumber", "status", "items", "notifyCustomer"] },
    "be-observer.sales_order_shipment_create": { "raisedBy": "order.shipped", "value": ["id", "orderId", "incrementId", "erpNumber", "status", "items", "notifyCustomer", "stockSourceCode"], "note": "items are THAT shipment's quantities, not the whole order; stockSourceCode names the warehouse it shipped from, or is null" },
    "be-observer.sales_order_invoice_create": { "raisedBy": "order.invoiced", "value": ["id", "orderId", "incrementId", "erpNumber", "status", "items", "notifyCustomer"] },
    "be-observer.sales_order_hold": { "raisedBy": "order.hold", "value": ["id", "orderId", "incrementId", "erpNumber", "status", "items", "notifyCustomer", "held", "reason"], "note": "held true puts the Commerce order On Hold (the ERP created the order and held it for credit), false takes it off (a release); reason is the ERP's credit reason, or null on a release. A reject is a cancel and travels as sales_order_cancel" },
    "be-observer.sales_order_cancel": { "raisedBy": "order.cancelled", "value": ["id", "orderId", "incrementId", "erpNumber", "status", "items", "notifyCustomer", "reason"], "note": "reason is one of the ERP's own cancellation reasons, for the Commerce order comment" },
    "be-observer.company_credit_update": { "raisedBy": "partner.creditLimit", "value": ["partnerId", "companyId", "creditLimit"] },
    "be-observer.company_status_update": { "raisedBy": "partner.blocked", "value": ["partnerId", "companyId", "blocked"] }
  },
  "orderEventItem": ["orderItemId", "qty", "sku"],
  "delivery": {
    "webhookPath": "/api/v1/web/ingestion/webhook",
    "body": { "data": ["uid", "event", "value"] },
    "maxAttempts": 10
  },
  "sync": {
    "description": "What the ERP asks of its subscriber when someone chooses Sync records on its Settings page: start re-sending the records it mirrors, in the background, and answer at once. The ERP then watches its own last-import time.",
    "method": "POST",
    "path": "/api/v1/web/erp/mirror?background=true",
    "answers": 202,
    "status": {
      "description": "How the subscriber reports a sync it runs: POST admin/sync with one step at a time. A run starts with state running, phase reading; then phase partners and phase products with { done, total } counts; and ends with state done, or failed with an error a person can act on. health answers the latest record as sync.",
      "states": ["requested", "running", "done", "failed"],
      "phases": ["reading", "partners", "products"],
      "progress": ["done", "total"]
    }
  }
}
